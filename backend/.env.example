# Postgres connection string (Neon or any Postgres 14+)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any OpenAI model that supports the web_search tool in the Responses API
OPENAI_MODEL=gpt-5.5
# low | medium | high  (leave blank for models without reasoning)
OPENAI_REASONING_EFFORT=low
# low | medium | high - page text pulled in per web search (high = slower, more tokens)
OPENAI_SEARCH_CONTEXT=medium
# Max web searches per jurisdiction (0 = unlimited)
OPENAI_MAX_TOOL_CALLS=8
# Saved jurisdiction rules older than this are re-researched on the next lookup
CACHE_TTL_DAYS=3
